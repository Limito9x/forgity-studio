{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Forgity Studio",
  "version": "1.0.1",
  "identifier": "studio.forgity.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Forgity Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/forgity-runner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNkFCQjZBQzZCRUFFM0MKUldROHJyN0dhcnRxUFBnUzFTYkRtWithbkllR1g2aElXOUZ4bVBuVC9vYXNVY3VqYktkaWxTTk4K",
      "endpoints": [
        "https://github.com/Limito9x/forgity-studio/releases/latest/download/latest.json"
      ]
    }
  }
}